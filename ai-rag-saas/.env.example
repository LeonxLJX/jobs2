# ===== 数据库配置 / Database =====
# 默认使用 SQLite，开箱即用 / Default SQLite, works out of the box
# 切换 PostgreSQL：取消注释下面一行 / To switch to PostgreSQL, uncomment the line below
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/ai_rag_saas?schema=public"

# ===== JWT 认证 / JWT Auth =====
JWT_SECRET="change-me-to-a-very-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# ===== AI 配置（可选，留空走 Mock）/ AI Config (optional, empty = mock mode) =====
# 留空时使用本地 Mock RAG（关键词检索），无需联网
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
EMBEDDING_MODEL="text-embedding-3-small"
CHAT_MODEL="gpt-4o-mini"

# ===== 应用配置 / App =====
# 免费用户每日提问配额 / Free user daily question quota
FREE_DAILY_QUOTA=10
