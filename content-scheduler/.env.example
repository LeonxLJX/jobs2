# 数据库连接地址
# 默认 SQLite，本地文件数据库
DATABASE_URL="file:./dev.db"
# 如需切换 PostgreSQL，取消注释并修改：
# DATABASE_URL="postgresql://user:password@localhost:5432/content_scheduler?schema=public"

# JWT 相关配置
JWT_SECRET="please-change-me-to-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# SMTP 邮件配置（留空则使用控制台 mock 输出）
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_FROM="noreply@content-scheduler.local"

# 定时任务调度表达式（默认每分钟执行一次）
CRON_SCHEDULE="* * * * *"
