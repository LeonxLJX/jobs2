# ============================================================
# 后端环境变量示例 / Backend Environment Variables Example
# 复制为 .env 并按需修改 / Copy to .env and modify as needed
# ============================================================

# 数据库连接 / Database URL
# SQLite（默认） / SQLite (default):
DATABASE_URL="file:./dev.db"
# PostgreSQL（可选） / PostgreSQL (optional):
# DATABASE_URL="postgresql://user:password@localhost:5432/membership?schema=public"

# JWT 配置 / JWT Config
JWT_SECRET="your-super-secret-jwt-key-change-me"
JWT_EXPIRES_IN="7d"

# 服务端口 / Server Port
PORT=3000

# 支付模式 / Payment Mode: mock | stripe
PAYMENT_MODE=mock

# Stripe 配置（可选，留空走 mock 模式）/ Stripe Config (optional, empty = mock mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stripe 前端回调地址 / Stripe Frontend Redirect URLs
STRIPE_SUCCESS_URL="http://localhost:5173/payment/success?session={SESSION_ID}"
STRIPE_CANCEL_URL="http://localhost:5173/payment/cancel"

# 跨域配置 / CORS
CORS_ORIGIN="http://localhost:5173"
