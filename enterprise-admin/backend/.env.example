# 数据库连接 / Database connection
# 默认 SQLite，开箱即用 / Default SQLite, out of the box
DATABASE_URL="file:./dev.db"

# 如需使用 MySQL，取消下方注释并替换为你的连接信息 / To use MySQL, uncomment below and replace with your credentials
# DATABASE_URL="mysql://root:password@localhost:3306/enterprise_admin"

# JWT 配置 / JWT config
JWT_SECRET="super-secret-key-please-change-in-production"
JWT_EXPIRES_IN="7d"

# 服务端口 / Server port
PORT=3000

# 跨域前端地址 / CORS frontend origin
CORS_ORIGIN="http://localhost:5173"
