# 数据库连接 / Database connection
# 默认使用 SQLite（开箱即用）/ Default to SQLite (zero config)
DATABASE_URL="file:./dev.db"

# 如需使用 PostgreSQL，取消下方注释并注释掉上面的 SQLite 配置
# To use PostgreSQL, uncomment below and comment out the SQLite line above
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/team_doc?schema=public"

# JWT 配置 / JWT configuration
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# 服务端口 / Server port
PORT=3000

# 跨域 / CORS
CORS_ORIGIN="http://localhost:5173"

# 文件上传目录 / File upload directory
UPLOAD_DIR="uploads"

# 文件上传大小限制（字节）/ Max file size in bytes (10MB)
MAX_FILE_SIZE=10485760
